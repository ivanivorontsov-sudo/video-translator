{"manifest_version": 3, "name": "Переводчик видео", "version": "1.0.0",
 "description": "Перевод любого видео и аудио в браузере: субтитры, закадровый голос или оба. Готовые субтитры, Web Speech, Whisper, облачные движки по вашим ключам.",
 "action": {"default_popup": "vt/panel.html", "default_title": "Переводчик видео", "default_icon": {"16": "icons/i16.png", "48": "icons/i48.png", "128": "icons/i128.png"}},
 "icons": {"16": "icons/i16.png", "48": "icons/i48.png", "128": "icons/i128.png"},
 "background": {"service_worker": "background.js"},
 "permissions": ["tabCapture", "offscreen", "tts", "storage", "scripting", "activeTab"],
 "host_permissions": ["<all_urls>"],
 "content_scripts": [{"matches": ["<all_urls>"], "js": ["vt/common.js", "vt/content.js"], "run_at": "document_idle"}],
 "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"},
 "commands": {"_execute_action": {"suggested_key": {"default": "Alt+T"}}}}
